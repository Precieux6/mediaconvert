# ========================================
# OmniConvert Configuration
# ========================================

# Environnement (development / production)
ENVIRONMENT=development

# Server
PORT=8000
HOST=0.0.0.0

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000  # 500MB en bytes

# Render
RENDER=false
RENDER_EXTERNAL_URL=https://votre-app.render.com
